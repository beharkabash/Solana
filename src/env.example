# ========================================
# SOLANA MEMECOIN MONITOR CONFIGURATION
# ========================================

# ✅ REQUIRED: Target Wallet Monitoring Configuration
COPY_TRADING_TARGET_ADDRESS=YOUR_TARGET_WALLET_ADDRESS_HERE
IS_MULTI_COPY_TRADING=true
EXCLUDED_ADDRESSES=
COUNTER_LIMIT=10  # Increase this to allow monitoring more tokens simultaneously

# ✅ REQUIRED: Trading Configuration
TOKEN_AMOUNT=0.001 # token amount to purchase
BUY_IN_SELL=0.02
BUY_IN_SELL_LIMIT=30 # if target sell token for more than 10 sol, buy BUY_IN_SELL amount

# ✅ REQUIRED: RPC Configuration
RPC_HTTP=https://api.mainnet-beta.solana.com
RPC_WSS=wss://api.mainnet-beta.solana.com
YELLOWSTONE_GRPC_HTTP=https://grpc.ny.shyft.to
YELLOWSTONE_GRPC_TOKEN=YOUR_GRPC_TOKEN_HERE

# ✅ REQUIRED: Wallet Configuration
PRIVATE_KEY=YOUR_PRIVATE_KEY_BASE58_HERE

# ⚡ Performance Settings
UNIT_PRICE=2000000
UNIT_LIMIT=2000000
SELLING_UNIT_PRICE=4000000
SELLING_UNIT_LIMIT=2000000
ZERO_SLOT_TIP_VALUE=0.0025

# 🎯 Sniper Bot Focus Token Settings
FOCUS_DROP_THRESHOLD_PCT=0.15  # 15% price drop to mark as "dropped"
FOCUS_TRIGGER_SOL=1.0  # Minimum SOL buy size to trigger after drop

# 💰 Enhanced Selling Strategy
COPY_SELLING_LIMIT=1.5
TAKE_PROFIT=8.0      # Take profit percentage
STOP_LOSS=-2         # Stop loss percentage
MAX_HOLD_TIME=3600   # Maximum hold time in seconds
DYNAMIC_RETRACEMENT_PERCENTAGE=15
RETRACEMENT_PNL_THRESHOLD=15
RETRACEMENT_THRESHOLD=15
MIN_LIQUIDITY=4

# 📈 Dynamic Trailing Stop Configuration
TRAILING_STOP_ACTIVATION_PERCENTAGE=20.0  # Minimum PnL to activate trailing stop
TRAILING_STOP_TRAIL_PERCENTAGE=10.0       # Fallback trailing stop percentage
# Format: "pnl_threshold:trail_percentage,pnl_threshold:trail_percentage,..."
DYNAMIC_TRAILING_STOP_THRESHOLDS=20:5,50:10,100:30,200:100,500:100,1000:100

# ⚙️ Transaction Settings
TRANSACTION_LANDING_SERVICE=0  # 0=normal, 1=zeroslot
SLIPPAGE=3000
MAX_WAIT_TIME=650000  # 600 seconds
TIME_EXCEED=10        # seconds; time limit for volume non-increasing

# 🚀 ZeroSlot Configuration (Optional)
ZERO_SLOT_URL=http://ny1.0slot.trade/?api-key=YOUR_API_KEY
ZERO_SLOT_HEALTH=https://ny1.0slot.trade/health
JITO_TIP_VALUE=0.001

# 💬 Telegram Alerts (Optional - for Python monitoring system)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# 🧠 ML SCORING SYSTEM CONFIGURATION
MIN_LIQUIDITY_USD=5000       # Minimum liquidity for token consideration
MIN_MARKET_CAP_USD=3000      # Minimum market cap
MIN_VOLUME_24H=1000          # Minimum 24h volume
MIN_HOLDERS=5                # Minimum holder count
MAX_TOKEN_AGE_HOURS=48       # Maximum token age to consider
MAX_BUY_TAX_PERCENT=3.0      # Maximum buy tax
MAX_SELL_TAX_PERCENT=3.0     # Maximum sell tax
ML_SUCCESS_THRESHOLD=5.0     # 5% profit threshold for ML training

# 📊 SCORING WEIGHTS (Advanced - Optional)
LIQUIDITY_WEIGHT=15.0
VOLUME_WEIGHT=20.0
HOLDER_DISTRIBUTION_WEIGHT=15.0
CONTRACT_VERIFICATION_WEIGHT=20.0
SOCIAL_PRESENCE_WEIGHT=10.0
WEBSITE_QUALITY_WEIGHT=5.0
TOKEN_ECONOMICS_WEIGHT=15.0

# 🔧 PYTHON MONITOR CONFIGURATION
SOLANA_ENABLED=true
ETHEREUM_ENABLED=false
BNB_ENABLED=false
BASE_ENABLED=false
DAILY_ALERT_TARGET=100
HIGH_CONFIDENCE_THRESHOLD=75
MEDIUM_CONFIDENCE_THRESHOLD=60
MINIMUM_ALERT_SCORE=60

# 📈 CHAIN ALERT DISTRIBUTION PERCENTAGES
SOLANA_ALERT_PERCENTAGE=100
ETHEREUM_ALERT_PERCENTAGE=0
BNB_ALERT_PERCENTAGE=0
BASE_ALERT_PERCENTAGE=0

# 🧪 DEVELOPMENT SETTINGS
DRY_RUN=false                # Set to true for testing without real trades
WRAP_AMOUNT=0.5              # Amount of SOL to wrap for testing
